  "mcp": {
    "server": {
      "name": "transferred-smart-expense-manager",
      "version": "0.1.0",
      "title": "Transferred Smart Expense Manager"
    },
    "tools": [
      {
        "name": "get_overview",
        "title": "Get account overview",
        "description": "List the signed-in user's accounts, categories (Main > Sub), tags, SMS identifiers, SMS settings, and the saved assistant memory (preferences + merchant rules), with IDs to use in other tools.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_expenses",
        "title": "List expenses",
        "description": "List expenses with optional filters (date range, account, category, tag, amount, text). Returns resolved names.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Start date YYYY-MM-DD (inclusive)"
            },
            "to": {
              "type": "string",
              "description": "End date YYYY-MM-DD (inclusive)"
            },
            "account_id": {
              "type": "string",
              "format": "uuid"
            },
            "category_id": {
              "type": "string",
              "format": "uuid"
            },
            "tag_id": {
              "type": "string",
              "format": "uuid"
            },
            "min_amount": {
              "type": "number"
            },
            "max_amount": {
              "type": "number"
            },
            "search": {
              "type": "string",
              "description": "Text to find in description"
            },
            "sort": {
              "type": "string",
              "enum": [
                "date_desc",
                "date_asc",
                "amount_desc",
                "recent_added"
              ]
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "description": "Default 100"
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "spending_summary",
        "title": "Spending summary",
        "description": "Totals for a date range grouped by category, main category, account, tag, month or description (merchant). Credits/refunds are subtracted.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from": {
              "type": "string",
              "description": "Start date YYYY-MM-DD"
            },
            "to": {
              "type": "string",
              "description": "End date YYYY-MM-DD"
            },
            "group_by": {
              "type": "string",
              "enum": [
                "category",
                "main_category",
                "account",
                "tag",
                "month",
                "merchant"
              ]
            },
            "top": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "Return only top N groups"
            }
          },
          "required": [
            "from",
            "to",
            "group_by"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_recurring",
        "title": "List recurring expenses",
        "description": "List the user's recurring expenses (subscriptions, rent, etc.).",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {},
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "add_expense",
        "title": "Add expense",
        "description": "Add an expense (or a credit/refund). Category and account are required. Refuses if the same date + whole amount already exists unless force is true.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "description": "YYYY-MM-DD"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "category_id": {
              "type": "string",
              "format": "uuid"
            },
            "account_id": {
              "type": "string",
              "format": "uuid"
            },
            "tag_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "debit",
                "credit"
              ],
              "description": "debit = expense (default), credit = refund"
            },
            "force": {
              "type": "boolean",
              "description": "Add even if a possible duplicate exists (only when the user confirms it's a different purchase)"
            }
          },
          "required": [
            "date",
            "description",
            "amount",
            "category_id",
            "account_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "update_expense",
        "title": "Update expenses",
        "description": "Edit one or more expenses. Only the fields you pass are changed (e.g. bulk recategorize by passing several IDs and a category_id).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "minItems": 1,
              "maxItems": 500
            },
            "date": {
              "type": "string"
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "amount": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "category_id": {
              "type": "string",
              "format": "uuid"
            },
            "account_id": {
              "type": "string",
              "format": "uuid"
            },
            "tag_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "format": "uuid"
              },
              "description": "Replaces all tags"
            },
            "type": {
              "type": "string",
              "enum": [
                "debit",
                "credit"
              ]
            }
          },
          "required": [
            "ids"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "delete_expenses",
        "title": "Delete expenses",
